{
  "name": "dsh-famling",
  "version": "0.8.6",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "embed:anims": "node scripts/embed-anims.mjs",
    "check:anims": "node scripts/embed-anims.mjs --check",
    "verify:anims": "node scripts/verify-anims.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "qa:anims": "node scripts/embed-anims.mjs --qa"
  },
  "description": "Famling mini pet in the DSH sidebar footer: Tinglan / Selkirk Rex cat / Golden Retriever pixel animations, region-aware pet interactions with species-specific actions and random bubble lines, chat personas, and a link to the standalone famling app.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "client.anims.human.js",
    "client.anims.cat.js",
    "client.anims.dog.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png",
    "README.md",
    "LICENSE",
    "LICENSE-ART",
    "NOTICE",
    "docs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "famling",
    "desktop-pet",
    "tinglan"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
