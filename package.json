{
  "name": "dsh-famling",
  "version": "0.13.2",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/embed-anims.mjs --check && node scripts/gen-content-constants.mjs --check",
    "verify": "node scripts/verify-anims.mjs",
    "gen:content": "node scripts/gen-content-constants.mjs",
    "check:content": "node scripts/gen-content-constants.mjs --check",
    "lint": "node scripts/check-jsdoc.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "embed:anims": "node scripts/embed-anims.mjs",
    "check:anims": "node scripts/embed-anims.mjs --check",
    "verify:anims": "node scripts/verify-anims.mjs",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "qa:anims": "node scripts/embed-anims.mjs --qa",
    "check:package": "node scripts/check-package.mjs",
    "verify:package": "node scripts/check-package.mjs --pack",
    "release:check": "npm test && npm run check && npm run verify && npm run verify:package && npm run lint && npm run typecheck",
    "prepack": "node scripts/check-package.mjs --prepack"
  },
  "description": "Famling mini pet in the DSH sidebar footer: Tinglan / Ragdoll cat / Golden Retriever pixel animations with a minimal zero-button UI, a right-click / Shift+F10 hierarchical menu, region-aware interactions, chat personas, a role-as-theme content center (roles / customize / packs / market), a unified settings popup with low-disturb controls (quiet hours / reduce-motion / temporary hide), and a reserved v3 third-party content-pack contract with a mandatory research-only usage declaration.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-famling.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-famling#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-famling/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./content-extension": "./content-extension.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "client.behavior.js",
    "client.status.js",
    "client.anims.human.js",
    "client.anims.cat.js",
    "client.anims.dog.js",
    "client.content.js",
    "content-extension.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png",
    "README.md",
    "README.en.md",
    "LICENSE",
    "LICENSE-ART",
    "NOTICE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "famling",
    "desktop-pet",
    "tinglan"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0 || >=0.2.2-0 <0.3.0"
  }
}
