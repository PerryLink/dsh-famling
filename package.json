{
  "name": "dsh-famling",
  "version": "0.2.3",
  "private": false,
  "type": "module",
  "description": "Famling mini pet in the DSH sidebar footer: Tinglan interactions and a link to the standalone famling app.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png",
    "README.md",
    "LICENSE",
    "LICENSE-ART",
    "NOTICE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "famling",
    "desktop-pet",
    "tinglan"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  }
}
