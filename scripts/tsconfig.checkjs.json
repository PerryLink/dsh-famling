{
  // MB-107 tooling checkJs config (consumed by scripts/typecheck.mjs).
  //
  // Scope is intentionally the Node tooling layer that MB-107 owns and keeps
  // fully JSDoc-typed. The browser bundles are excluded on purpose:
  //   - client.js / client.content.js / client.anims.*.js are not ES modules
  //     (they register through window.__ModuleLoader__), so they are not
  //     checkJs-able without a custom ambient module declaration;
  //   - content-extension.mjs (v3 wire validator) predates checkJs and its
  //     deliberate `unknown` narrowing currently reports ~40 pre-existing
  //     errors. It is still covered by scripts/check-jsdoc.mjs (JSDoc gate) and
  //     its contract is frozen by test/parity-contract.test.js; typing the
  //     validator is a documented follow-up (MB-108), not silently ignored here.
  //
  // Run through the package gate so the script can locate the workspace
  // TypeScript/@types/node install and skip honestly when neither is present:
  //   npm run typecheck
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "./check-jsdoc.mjs",
    "./check-package.mjs",
    "./embed-anims.mjs",
    "./gen-content-constants.mjs",
    "./measure-bundle.mjs",
    "./typecheck.mjs",
    "./verify-anims.mjs"
  ],
  "exclude": ["../client.js", "../client.content.js", "../content-extension.mjs", "../test", "../node_modules"]
}
